# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Personal details (used to fill application forms) ---
FULL_NAME="Jane Doe"
EMAIL=jane@example.com
PHONE="+1 555 000 0000"
LOCATION="Berlin, Germany"
LINKEDIN_URL=https://linkedin.com/in/janedoe
GITHUB_URL=https://github.com/janedoe
PORTFOLIO_URL=
WORK_AUTHORIZATION="EU citizen"
NOTICE_PERIOD="1 month"
EXPECTED_SALARY=

# --- CV ---
# Option A (recommended): path to your CV file, kept in the gitignored private/ folder.
# .pdf, .md or .txt. Its text is used for matching and cover letters,
# and the file itself is uploaded to application forms.
CV_PATH=private/cv.pdf
# Option B: paste the CV as text (multi-line allowed inside double quotes).
CV_TEXT=""

# --- Search preferences ---
JOB_KEYWORDS="python developer, backend engineer"
JOB_LOCATION="Germany"
# Jobs in these places are allowed on-site; jobs anywhere else must be remote.
HOME_LOCATIONS="Bangladesh, Dhaka, Chittagong, Chattogram, Sylhet, Khulna, Rajshahi, Gazipur"
# true = remote jobs only, even at home
REMOTE_ONLY=false
MAX_RESULTS_PER_SOURCE=25
MIN_MATCH_SCORE=70
MAX_APPLICATIONS_PER_RUN=10
# Skills not in job_agent/skills.py that you want matched (comma-separated)
EXTRA_SKILLS=""

# --- Optional job sources ---
# Free keys from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de
